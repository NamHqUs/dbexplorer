{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Data Source=dbexplorer.db"
  },
  "Auth": {
    "AllowRegistration": false
  },
  "Jwt": {
    "Issuer": "DbExplorer",
    "Audience": "DbExplorer.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
